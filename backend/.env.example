# EduTrack QR Backend Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE SECRETS BEFORE STARTING THE SERVER

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/student_portal_db

# MANDATORY: Generate a high-entropy secret (e.g. openssl rand -hex 32)
JWT_SECRET=your_high_entropy_jwt_secret_key_here

# Client URL for CORS boundary protection
CLIENT_ORIGIN=http://localhost:5173
